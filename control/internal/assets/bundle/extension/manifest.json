{
  "manifest_version": 3,
  "name": "Manga Translator",
  "version": "0.5.9",
  "description": "브라우저에서 만화 이미지를 읽고 로컬 또는 원격 서버에서 번역합니다.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Manga Translator",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "options_page": "options.html",
  "minimum_chrome_version": "142",
  "key": "",
  "externally_connectable": {
    "matches": [
      "<all_urls>"
    ]
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
